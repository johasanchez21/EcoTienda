<?xml version="1.0" encoding="UTF-8"?>

<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="001-create-carrito" author="johann">

        <createTable tableName="carrito">

            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>

            <column name="usuario_id" type="BIGINT">
                <constraints nullable="false" unique="true"/>
            </column>

        </createTable>

    </changeSet>

    <changeSet id="002-create-carrito-item" author="johann">

        <createTable tableName="carrito_item">

            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>

            <column name="cantidad" type="INT">
                <constraints nullable="false"/>
            </column>

            <column name="precio" type="INT">
                <constraints nullable="false"/>
            </column>

            <column name="carrito_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="producto_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

        </createTable>

    </changeSet>

</databaseChangeLog>